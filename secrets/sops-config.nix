# Renders .sops.yaml from ./keys.nix. Used by `nix run .#sops-config`.
#   secrets/common.yaml  -> admins + every host with a key
#   secrets/<host>.yaml  -> admins + that host
keys: let
  inherit (builtins) attrNames concatStringsSep filter map;
  adminNames = attrNames keys.admins;
  hostNames = attrNames keys.hosts;
  keyedHosts = filter (h: keys.hosts.${h} != null) hostNames;

  anchors =
    map (n: "  - &${n} ${keys.admins.${n}}") adminNames
    ++ map (n: "  - &${n} ${keys.hosts.${n}}") keyedHosts;

  rule = file: names:
    concatStringsSep "\n" ([
        "  - path_regex: (^|/)secrets/${file}\\.yaml$"
        "    key_groups:"
        "      - age:"
      ]
      ++ map (n: "          - *${n}") names);

  hostRule = h:
    rule h (adminNames
      ++ (
        if keys.hosts.${h} != null
        then [h]
        else []
      ));
in
  concatStringsSep "\n" ([
      "# GENERATED by `nix run .#sops-config` from secrets/keys.nix - do not edit by hand."
      "# See docs/sops.md."
      "keys:"
    ]
    ++ anchors
    ++ ["creation_rules:" (rule "common" (adminNames ++ keyedHosts))]
    ++ map hostRule hostNames)
  + "\n"
